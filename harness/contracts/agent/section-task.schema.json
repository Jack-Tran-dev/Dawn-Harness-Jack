{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopify-theme-harness/contracts/agent/section-task.schema.json",
  "title": "Shopify Theme Section Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pageKey",
    "profile",
    "surfaceType",
    "sectionId",
    "sectionKey",
    "templateSectionId",
    "expectedResultPath",
    "implementationTarget",
    "implementationPolicy",
    "fidelity",
    "templateContract",
    "inputs",
    "brief"
  ],
  "properties": {
    "pageKey": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "enum": ["kik"]
    },
    "surfaceType": {
      "type": "string",
      "enum": ["page", "product", "cart", "global"]
    },
    "sectionId": {
      "type": "string",
      "minLength": 1
    },
    "sectionKey": {
      "type": "string",
      "minLength": 1
    },
    "templateSectionId": {
      "type": "string",
      "minLength": 1,
      "description": "Section id used as the key inside Shopify template JSON (sections.<templateSectionId>). Shopify rejects ids that contain consecutive underscores or anything outside [a-z0-9_], and ids must start with a lowercase letter. The pattern below catches the common mistakes (kebab-case slugs from page keys like `home-v2`, accidental `__` from concatenating `<page>__<section>`) at brief-author time instead of at theme push.",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
    },
    "expectedResultPath": {
      "type": "string",
      "minLength": 1
    },
    "implementationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectionFile", "snippetFiles", "previewTemplate"],
      "properties": {
        "sectionFile": {
          "type": "string",
          "minLength": 1
        },
        "snippetFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "previewTemplate": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "implementationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "repeatedContentSource",
        "defaultImplementation",
        "allowedImplementationExceptions",
        "themeCodeReuse"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "enum": ["static", "carousel"]
        },
        "repeatedContentSource": {
          "type": "string",
          "enum": ["settings", "blocks"]
        },
        "defaultImplementation": {
          "type": "string",
          "enum": ["none", "swiper", "scroll-snap"]
        },
        "allowedImplementationExceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["scroll-snap"]
          }
        },
        "themeCodeReuse": {
          "type": "string",
          "enum": ["avoid", "allow"]
        }
      }
    },
    "dataBinding": {
      "$ref": "#/$defs/dataBinding"
    },
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "ignoreImageContent", "requireExplicitLayoutReview"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["standard", "css-1-to-1"]
        },
        "ignoreImageContent": {
          "type": "boolean"
        },
        "requireExplicitLayoutReview": {
          "type": "boolean"
        }
      }
    },
    "templateContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectionType", "allowedSettingIds", "blockPolicy"],
      "properties": {
        "sectionType": {
          "type": "string",
          "minLength": 1
        },
        "allowedSettingIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blockPolicy": {
          "type": "string",
          "enum": ["forbidden", "open"]
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desktopBundlePath",
        "mobileBundlePath",
        "starterSectionPath",
        "reviewManifestSection"
      ],
      "properties": {
        "desktopBundlePath": {
          "type": "string",
          "minLength": 1
        },
        "mobileBundlePath": {
          "type": "string",
          "minLength": 1
        },
        "desktopDetailPath": {
          "type": "string",
          "minLength": 1
        },
        "mobileDetailPath": {
          "type": "string",
          "minLength": 1
        },
        "sourceManifestPath": {
          "type": "string",
          "minLength": 1
        },
        "sourceManifestSection": {
          "type": "string",
          "minLength": 1
        },
        "figmaSource": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "desktop": {
              "$ref": "#/$defs/figmaSourceRef"
            },
            "mobile": {
              "$ref": "#/$defs/figmaSourceRef"
            }
          }
        },
        "starterSectionPath": {
          "type": "string",
          "minLength": 1
        },
        "reviewManifestSection": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "content",
        "layout",
        "diagnostics"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["textSnippets", "imageAssetPaths", "callsToAction", "primaryMessage", "supportingMessages", "ctaLabels"],
          "properties": {
            "textSnippets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "imageAssetPaths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dataBinding": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "summary"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["product", "collection", "article", "metaobject"]
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "callsToAction": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "primaryMessage": {
              "type": ["string", "null"]
            },
            "supportingMessages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ctaLabels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desktop", "mobile"],
          "properties": {
            "desktop": {
              "$ref": "#/$defs/variantBrief"
            },
            "mobile": {
              "$ref": "#/$defs/variantBrief"
            }
          }
        },
        "blocks": {
          "type": "array",
          "description": "Per-slide / per-block content + asset map. Required when implementationPolicy.pattern === 'carousel' (the agent renders multiple slides; each slide carries its own background asset + copy). For static sections this field is omitted; brief.layout.{breakpoint}.backgroundFillPath is the single asset. Source-manifest agents populate one entry per Figma carousel slide. If source-manifest cannot recover per-slide assets (designer mocked all slides into a single frame, or the slides are page-nav variants that don't expose per-block image-fills), emit blocks with imageDesktop=null/imageMobile=null and add a brief.diagnostics entry — the implementing agent then declares the limitation in section-result.openIssues rather than silently rendering the same image on every slide.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["blockIndex"],
            "properties": {
              "blockIndex": {
                "type": "integer",
                "minimum": 0,
                "description": "Zero-based position of this block within the section's intended block_order. Stable across re-runs."
              },
              "blockType": {
                "type": "string",
                "minLength": 1,
                "description": "Block type identifier matching the section schema (e.g. 'slide'). Optional; helpful for sections that mix block types."
              },
              "imageDesktop": {
                "type": ["string", "null"],
                "minLength": 1,
                "description": "Local path of the desktop image-fill asset for this slide / block. Null when the block has no image fill or the asset could not be recovered from Figma."
              },
              "imageMobile": {
                "type": ["string", "null"],
                "minLength": 1,
                "description": "Local path of the mobile image-fill asset for this slide / block. Null when the block has no mobile-specific asset (renderer should fall back to imageDesktop)."
              },
              "heading": {
                "type": ["string", "null"]
              },
              "body": {
                "type": ["string", "null"]
              },
              "ctaLabel": {
                "type": ["string", "null"]
              },
              "ctaUrl": {
                "type": ["string", "null"]
              }
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "figma": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "desktop": {
                  "$ref": "#/$defs/figmaSourceRef"
                },
                "mobile": {
                  "$ref": "#/$defs/figmaSourceRef"
                }
              }
            },
            "mcpInspections": {
              "type": "array",
              "description": "Provenance for agent-authored briefs (source-manifest flow). Each entry records a Figma MCP call whose returned metadata fed the brief. The verifier and downstream review can cross-check that every brief region's sourceNodeId appears in some inspection's childNodeIds.",
              "items": {
                "$ref": "#/$defs/mcpInspection"
              }
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/briefDiagnostic"
          }
        }
      }
    }
  },
  "$defs": {
    "dataBinding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "handle"],
          "properties": {
            "kind": {
              "const": "product"
            },
            "handle": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "handle"],
          "properties": {
            "kind": {
              "const": "collection"
            },
            "handle": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "blog"],
          "properties": {
            "kind": {
              "const": "article"
            },
            "blog": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "type"],
          "properties": {
            "kind": {
              "const": "metaobject"
            },
            "type": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "briefDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "error"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "breakpoint": {
          "type": "string",
          "enum": ["desktop", "mobile"]
        }
      }
    },
    "figmaSourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileKey", "pageId", "pageName", "nodeId", "nodeUrl"],
      "properties": {
        "fileKey": {
          "type": "string",
          "minLength": 1
        },
        "pageId": {
          "type": "string",
          "minLength": 1
        },
        "pageName": {
          "type": "string",
          "minLength": 1
        },
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "nodeUrl": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "variantBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview",
        "canvas",
        "rootNodeType",
        "textNodeCount",
        "imageNodeCount",
        "layoutPattern",
        "dominantTextPlacement",
        "dominantImagePlacement",
        "readingOrderTextRegions",
        "topTextRegions",
        "topImageRegions",
        "primaryTextBox",
        "primaryImageBox",
        "assetPaths",
        "diagnostics"
      ],
      "properties": {
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "pixelWidth", "pixelHeight"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "pixelWidth": {
              "type": "integer",
              "minimum": 0
            },
            "pixelHeight": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {
              "type": "number",
              "minimum": 0
            },
            "height": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "rootNodeType": {
          "type": "string",
          "minLength": 1
        },
        "textNodeCount": {
          "type": "integer",
          "minimum": 0
        },
        "imageNodeCount": {
          "type": "integer",
          "minimum": 0
        },
        "layoutPattern": {
          "type": "string",
          "enum": ["unknown", "text-only", "image-only", "split", "stacked", "overlay", "mixed"]
        },
        "dominantTextPlacement": {
          "type": "string",
          "enum": ["none", "left", "right", "top", "bottom", "center", "full-bleed"]
        },
        "dominantImagePlacement": {
          "type": "string",
          "enum": ["none", "left", "right", "top", "bottom", "center", "full-bleed"]
        },
        "readingOrderTextRegions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/briefRegion"
          }
        },
        "topTextRegions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/briefRegion"
          }
        },
        "topImageRegions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/briefImageRegion"
          }
        },
        "primaryTextBox": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "minimum": 0
            },
            "height": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "primaryImageBox": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "minimum": 0
            },
            "height": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "assetPaths": {
          "type": "array",
          "description": "Flat list of every local asset that source-manifest associated with this breakpoint variant — both the frame export (also referenced by preview.path) and any image-fill layer exports. The agent must NOT pick a section background by index from this array; use backgroundFillPath (single-asset sections) or brief.blocks[*].imageDesktop / imageMobile (carousels) instead. assetPaths is the catch-all for review tooling and asset upload, not the authoritative role-aware source.",
          "items": {
            "type": "string"
          }
        },
        "backgroundFillPath": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Local path of the Figma image-fill layer that backs this section variant — the asset the agent should reference as a section background, hero image, etc. Distinct from preview.path, which is a frame screenshot that typically contains the full visual mock (text overlays, decorations, design watermarks) and is intended only for human visual-baseline review. Set to null when the section has no image fill, or when the section is a multi-block carousel (use brief.blocks[*].imageDesktop / imageMobile in that case)."
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/briefDiagnostic"
          }
        }
      }
    },
    "briefRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "x", "y", "width", "height"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "sourceNodeId": {
          "type": "string",
          "minLength": 1,
          "description": "Optional Figma node id this region was measured from (typically populated in source-manifest flow via get_metadata). When set, the implementation must annotate the corresponding DOM element with data-kik-region=\"<sourceNodeId>\" so the geometry probe in verify-section-preview can match brief regions to live DOM."
        }
      }
    },
    "mcpInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["breakpoint", "rootNodeId", "callType", "capturedAt", "childNodeIds"],
      "properties": {
        "breakpoint": {
          "type": "string",
          "enum": ["desktop", "mobile"]
        },
        "rootNodeId": {
          "type": "string",
          "minLength": 1
        },
        "callType": {
          "type": "string",
          "enum": ["get_metadata", "get_design_context"]
        },
        "capturedAt": {
          "type": "string",
          "minLength": 1,
          "description": "ISO 8601 timestamp of when the MCP call returned."
        },
        "childNodeIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Node ids whose measurements informed the brief. The provenance check passes when every brief region's sourceNodeId appears in some inspection's childNodeIds list (or matches the rootNodeId)."
        }
      }
    },
    "briefImageRegion": {
      "allOf": [
        {
          "$ref": "#/$defs/briefRegion"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "assetPath": {
              "type": ["string", "null"]
            }
          }
        }
      ]
    }
  }
}
