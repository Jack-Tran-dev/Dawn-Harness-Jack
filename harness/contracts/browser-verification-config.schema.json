{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopify-theme-harness/contracts/browser-verification-config.schema.json",
  "title": "Shopify Theme Browser Verification Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pagePreviewUrl",
    "productPreviewUrl",
    "cartPreviewUrl",
    "desktopViewport",
    "mobileViewport"
  ],
  "properties": {
    "pagePreviewUrl": {
      "type": "string",
      "minLength": 1
    },
    "productPreviewUrl": {
      "type": "string",
      "minLength": 1
    },
    "cartPreviewUrl": {
      "type": "string",
      "minLength": 1
    },
    "storefrontPassword": {
      "type": "string"
    },
    "desktopViewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "mobileViewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
