{
  "schemaVersion": "1.0.0",
  "shopify": {
    "storeDomain": "kikstart-dev-plus-store.myshopify.com"
  },
  "toolServer": {
    "baseUrl": "http://127.0.0.1:8787",
    "auth": {
      "type": "bearer-env",
      "tokenEnv": "SHOPIFY_AGENT_TOOL_TOKEN"
    },
    "capabilities": {
      "shopContext": true,
      "imageUpload": true
    },
    "routes": {
      "tokenResolve": {
        "method": "POST",
        "path": "/v1/export-tokens/resolve",
        "contentTypes": ["application/json"]
      },
      "shopContext": {
        "method": "GET",
        "path": "/v1/shop-context",
        "auth": "bearer"
      },
      "syncJobs": {
        "method": "POST",
        "path": "/v1/sync-jobs",
        "auth": "bearer",
        "contentTypes": ["multipart/form-data", "application/json"]
      },
      "syncJob": {
        "method": "GET",
        "path": "/v1/sync-jobs/:jobId"
      },
      "syncJobEvents": {
        "method": "GET",
        "path": "/v1/sync-jobs/:jobId/events",
        "response": "text/event-stream"
      }
    }
  }
}
