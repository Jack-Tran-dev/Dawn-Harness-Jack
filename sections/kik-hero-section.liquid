{%- liquid
  assign aria_label = section.settings.aria_label | default: 'Hero promotions'
  assign autoplay_delay = section.settings.autoplay_delay | default: 0
  assign slides = section.blocks
-%}
<kik-hero-carousel
  class="kik-component block relative w-full"
  data-section-id="{{ section.id }}"
  data-autoplay-delay="{{ autoplay_delay }}"
  data-loop="false"
  data-kik-region="11928:8842 11928:7873"
>
  <div
    class="swiper kik-hero__swiper relative w-full overflow-hidden"
    data-kik-hero-swiper
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ aria_label | escape }}"
  >
    <div class="swiper-wrapper">
      {%- for block in slides -%}
        <div
          class="swiper-slide relative isolate flex min-h-[670px] md:min-h-[700px] w-full flex-col justify-end items-center md:items-start px-page py-section-sm md:justify-center"
          data-kik-hero-slide="{{ forloop.index0 }}"
          aria-roledescription="slide"
          aria-label="{{ block.settings.heading | default: forloop.index | escape }}"
          {{ block.shopify_attributes }}
        >
          {%- comment -%} Background image (desktop default + mobile override) {%- endcomment -%}
          <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none" aria-hidden="true">
            {%- if block.settings.image != blank -%}
              {%- assign desktop_src = block.settings.image | image_url: width: 1600 -%}
              {%- if block.settings.image_mobile != blank -%}
                {%- assign mobile_src = block.settings.image_mobile | image_url: width: 828 -%}
              {%- else -%}
                {%- assign mobile_src = block.settings.image | image_url: width: 828 -%}
              {%- endif -%}
              <picture>
                <source media="(min-width: 768px)" srcset="{{ desktop_src }}">
                <img
                  src="{{ mobile_src }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
                  class="absolute inset-0 h-full w-full max-w-none object-cover"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              </picture>
            {%- else -%}
              <div class="absolute inset-0 bg-surface-inverse">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'absolute inset-0 h-full w-full object-cover opacity-60' }}
              </div>
            {%- endif -%}
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-black/0 to-transparent md:bg-gradient-to-l md:from-transparent md:via-black/0 md:to-black/40"></div>
          </div>

          {%- comment -%} Foreground content {%- endcomment -%}
          <div
            class="relative flex w-full max-w-full flex-col items-start gap-24 text-inverse md:max-w-[569px]"
            data-kik-hero-content
          >
            <div class="flex w-full flex-col items-start gap-16">
              {%- if block.settings.heading != blank -%}
                <h2
                  class="font-heading text-h1 leading-tight tracking-[-0.02em] m-0"
                  {% if forloop.first %}data-kik-region="11928:8845 11928:7876"{% endif %}
                >{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <p
                  class="font-sans text-body-lg leading-relaxed m-0"
                  {% if forloop.first %}data-kik-region="11928:8846 11928:7877"{% endif %}
                >{{ block.settings.body | escape }}</p>
              {%- endif -%}
            </div>
            {%- if block.settings.cta_label != blank -%}
              <a
                href="{{ block.settings.cta_url | default: '#' }}"
                class="inline-flex items-center justify-center gap-2 rounded-xsm bg-action-secondary px-32 py-12 font-sans text-body-md font-medium text-primary no-underline whitespace-nowrap transition-colors hover:bg-action-secondary-hover hover:text-inverse"
                {% if forloop.first %}data-kik-region="11928:8847 11928:7878"{% endif %}
              >{{ block.settings.cta_label | escape }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- if slides.size > 1 -%}
    <div
      class="kik-hero__pagination absolute left-1/2 -translate-x-1/2 bottom-32 flex gap-12 items-start md:left-auto md:translate-x-0 md:right-[72px] md:bottom-32"
      role="tablist"
      aria-label="{{ aria_label | escape }}"
      data-kik-region="11928:8848 11928:7879"
    >
      {%- for block in slides -%}
        <button
          type="button"
          class="kik-hero__dot block h-[4px] rounded-[24px] bg-surface transition-all duration-300 data-[kik-active=true]:w-[40px] data-[kik-active=false]:w-[8px] data-[kik-active=false]:bg-white/50 data-[kik-active=false]:opacity-40 cursor-pointer p-0 border-0"
          data-kik-hero-dot="{{ forloop.index0 }}"
          data-kik-active="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-label="Go to slide {{ forloop.index }}"
          aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</kik-hero-carousel>

{% schema %}
{
  "name": "Hero (Kik)",
  "tag": "section",
  "class": "kik-section kik-hero",
  "settings": [
    {
      "type": "header",
      "content": "Accessibility & motion"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Carousel ARIA label",
      "default": "Hero promotions"
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay delay (ms)",
      "info": "0 disables autoplay.",
      "min": 0,
      "max": 9500,
      "step": 500,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image (desktop)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Background image (mobile)",
          "info": "Optional. Falls back to the desktop image if unset."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "May Day Gift with Purchase"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Create a calming galaxy room for better sleep — and get up to 8 projector discs free."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "Shop Galaxy Projector"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "CTA link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero (Kik)",
      "category": "Kik Components",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
