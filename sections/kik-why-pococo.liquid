{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif

  assign section_bg_class = 'kik-why-pococo--bg-none'
  if section.settings.background_style == 'primary'
    assign section_bg_class = 'kik-why-pococo--bg-primary'
  endif

  assign list_classes = 'kik-why-pococo__list'
  if show_mobile_slider
    assign list_classes = list_classes | append: ' kik-why-pococo__list--slider'
  endif

  assign heading_size = section.settings.heading_size | default: 'h2'
-%}

<div
  class="kik-component kik-why-pococo color-{{ section.settings.color_scheme }} gradient {{ section_bg_class }}{% if section.settings.title == blank and section.settings.subheading == blank %} kik-why-pococo--no-heading{% endif %}"
  id="kik-why-pococo-{{ section.id }}"
>
  <div
    class="kik-why-pococo__inner mx-auto flex w-full max-w-[var(--kik-container-max-width)] flex-col gap-xl py-section-lg px-page"
  >
    {%- unless section.settings.title == blank and section.settings.subheading == blank -%}
      <div class="kik-why-pococo__intro">
        {%- unless section.settings.title == blank -%}
          <h2 class="kik-why-pococo__title kik-why-pococo__title--{{ heading_size }}">
            {{ section.settings.title }}
          </h2>
        {%- endunless -%}
        {%- unless section.settings.subheading == blank -%}
          <div class="kik-why-pococo__subheading rte">
            {{ section.settings.subheading }}
          </div>
        {%- endunless -%}
        {%- if section.settings.button_label != blank and show_mobile_slider -%}
          <a href="{{ section.settings.button_link }}" class="kik-why-pococo__title-link">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endunless -%}

    <slider-component class="block w-full">
      <ul
        class="{{ list_classes }}"
        id="Slider-{{ section.id }}"
        role="list"
        data-cols-mobile="{{ section.settings.columns_mobile }}"
        data-cols-desktop="{{ section.settings.columns_desktop }}"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign empty_column = ''
            if block.settings.image == blank and block.settings.title == blank and block.settings.text == blank and block.settings.link_label == blank
              assign empty_column = ' kik-why-pococo__item--empty'
            endif

            assign body_align = ''
            if section.settings.column_alignment == 'center'
              assign body_align = ' kik-why-pococo__body--center'
            endif
          -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="kik-why-pococo__item min-w-0{{ empty_column }}"
            {{ block.shopify_attributes }}
          >
            <div class="kik-why-pococo__card">
              {%- if block.settings.image != blank -%}
                <div class="kik-why-pococo__image-wrap">
                  <div class="kik-why-pococo__media">
                    {%- liquid
                      assign number_of_columns = section.settings.columns_desktop
                      assign number_of_columns_mobile = section.settings.columns_mobile
                      assign grid_space_desktop = number_of_columns | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                      assign grid_space_tablet = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                      assign grid_space_mobile = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | divided_by: 2 | plus: 30 | append: 'px'
                    -%}
                    {% capture sizes %}
                      (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ grid_space_desktop }}) / {{ number_of_columns }}),
                      (min-width: 990px) calc((100vw - {{ grid_space_desktop }}) / {{ number_of_columns }}),
                      (min-width: 768px) calc((100vw - {{ grid_space_tablet }}) / {{ number_of_columns_mobile }}),
                      calc((100vw - {{ grid_space_mobile }}) / {{ number_of_columns_mobile }})
                    {% endcapture %}
                    {{
                      block.settings.image
                      | image_url: width: 3200
                      | image_tag:
                        widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                        sizes: sizes,
                        class: 'kik-why-pococo__image'
                    }}
                  </div>
                </div>
              {%- endif -%}
              <div class="kik-why-pococo__body{{ body_align }}">
                {%- if block.settings.title != blank -%}
                  <h5 class="kik-why-pococo__column-title">{{ block.settings.title }}</h5>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="kik-why-pococo__column-text rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.link_label != blank -%}
                  <a
                    class="kik-why-pococo__column-link"
                    {% if block.settings.link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.link }}"
                    {% endif %}
                  >
                    {{- block.settings.link_label | escape -}}
                    <span class="inline-block" aria-hidden="true">&rarr;</span>
                  </a>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_mobile_slider -%}
        <div class="kik-why-pococo__slider-nav">
          <button
            type="button"
            class="kik-why-pococo__slider-btn"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span aria-hidden="true">&lsaquo;</span>
          </button>
          <div class="kik-why-pococo__slider-counter">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button
            type="button"
            class="kik-why-pococo__slider-btn"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span aria-hidden="true">&rsaquo;</span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>

    <div class="kik-why-pococo__footer{% if show_mobile_slider %} hidden md:flex{% endif %}">
      {%- if section.settings.button_label != blank -%}
        <a
          class="kik-why-pococo__btn"
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Kik Why Pococo",
  "class": "kik-section kik-why-pococo-section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Why Pococo Feels Different at Night",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Designed to help you create a calmer room, reduce screen time, and ease into rest.</p>"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h1", "label": "H1 — kik-text/size/h1" },
        { "value": "h2", "label": "H2 — kik-text/size/h2" },
        { "value": "h3", "label": "H3 — kik-text/size/h3" },
        { "value": "h4", "label": "H4 — kik-text/size/h4" },
        { "value": "h5", "label": "H5 — kik-text/size/h5" },
        { "value": "h6", "label": "H6 — kik-text/size/h6" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Button label",
      "label": "Button label",
      "info": "Leave blank to hide"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "column_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left",
      "label": "Column alignment"
    },
    {
      "type": "select",
      "id": "background_style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "primary", "label": "Show as column background" }
      ],
      "default": "none",
      "label": "Secondary background"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1",
      "label": "Number of columns on mobile"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": false,
      "label": "Enable swipe on mobile"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "default": "Column",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post.</p>",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "info": "Leave blank to hide"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kik Why Pococo",
      "category": "Kik Components",
      "settings": {
        "title": "Why Pococo Feels Different at Night",
        "heading_size": "h2",
        "subheading": "<p>Designed to help you create a calmer room, reduce screen time, and ease into rest.</p>"
      },
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}
